HOST=127.0.0.1
PORT=5000
# Optional. Without MongoDB, private local JSON files persist runs.
MONGODB_URI=
DATA_DIR=./data
# Set a strong token before binding beyond localhost. Sent as Bearer token.
APP_ACCESS_TOKEN=
# Total-tax tolerance supported by observed historical labels.
TOTAL_TAX_TOLERANCE=1
# Unapproved policies default to strict zero difference and remain visible.
COMPONENT_TOLERANCE=0
TAXABLE_TOLERANCE=0
INVOICE_VALUE_TOLERANCE=0
