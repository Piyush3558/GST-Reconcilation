{
  "name": "gst-reconciliation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "npm run analyze --workspace backend",
    "reconcile": "npm run reconcile --workspace backend",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces",
    "build": "npm run typecheck && npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "validate:history": "npm run validate:history --workspace backend",
    "test:e2e": "playwright test"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@types/yauzl": "^2.10.0",
    "concurrently": "^9.2.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "prettier": "^3.6.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
